# Download only for the full gallery and the performance scenarios, never for
# ordinary builds or tests. NAMES selects the pinned books; the default is the
# gallery's.
if(NOT DEFINED OUTPUT OR NOT DEFINED REFERENCES)
    message(FATAL_ERROR "Screenshot book output and references are required")
endif()
if(NOT DEFINED NAMES)
    set(NAMES alice maths moby-dick war-and-peace)
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(LOCK "${OUTPUT}/.prepare.lock" GUARD PROCESS TIMEOUT 30)
file(READ "${REFERENCES}" references)
foreach(name IN LISTS NAMES)
    string(JSON filename GET "${references}" "${name}" filename)
    string(JSON expected GET "${references}" "${name}" sha256)
    string(JSON url GET "${references}" "${name}" download)
    set(path "${OUTPUT}/${filename}")
    if(EXISTS "${path}")
        file(SHA256 "${path}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Cached screenshot book differs from its pinned reference: ${path}")
        endif()
    else()
        file(DOWNLOAD "${url}" "${path}.part" TLS_VERIFY ON TIMEOUT 60 STATUS status)
        list(GET status 0 result)
        if(NOT result EQUAL 0)
            file(REMOVE "${path}.part")
            message(FATAL_ERROR "Cannot download ${name}: ${status}. Existing gallery retained.")
        endif()
        file(SHA256 "${path}.part" actual)
        if(NOT actual STREQUAL expected)
            file(REMOVE "${path}.part")
            message(FATAL_ERROR "Downloaded screenshot book differs from its pinned reference: ${name}")
        endif()
        file(RENAME "${path}.part" "${path}")
    endif()
endforeach()
