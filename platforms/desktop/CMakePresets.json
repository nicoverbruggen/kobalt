{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "mac",
      "displayName": "Mac development app",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-mac",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "mac-perf",
      "inherits": "mac",
      "displayName": "Mac performance measurements",
      "binaryDir": "${sourceDir}/../../build/desktop-mac-perf",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux",
      "displayName": "Linux development app",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-perf",
      "inherits": "linux",
      "displayName": "Linux performance measurements",
      "binaryDir": "${sourceDir}/../../build/desktop-linux-perf",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    { "name": "mac", "configurePreset": "mac", "targets": ["Kobalt"], "jobs": 2 },
    { "name": "mac-kobo-checks", "configurePreset": "mac", "targets": ["kobo-checks"], "jobs": 2 },
    { "name": "mac-tests", "configurePreset": "mac", "targets": ["kobalt-tests"], "jobs": 2 },
    { "name": "mac-fast-tests", "configurePreset": "mac", "targets": ["kobalt-fast-tests"], "jobs": 2 },
    { "name": "mac-light-tests", "configurePreset": "mac", "targets": ["kobalt-desktop-tests"], "jobs": 2 },
    { "name": "mac-light-screenshots", "configurePreset": "mac", "targets": ["screenshots-light"], "jobs": 2 },
    { "name": "mac-screenshots", "configurePreset": "mac", "targets": ["screenshots"], "jobs": 2 },
    { "name": "mac-perf", "configurePreset": "mac-perf", "targets": ["perf"], "jobs": 2 },
    { "name": "mac-eval", "configurePreset": "mac", "targets": ["kobalt-eval-compare"], "jobs": 2 },
    { "name": "linux", "configurePreset": "linux", "targets": ["Kobalt"], "jobs": 2 },
    { "name": "linux-tests", "configurePreset": "linux", "targets": ["kobalt-tests"], "jobs": 2 },
    { "name": "linux-fast-tests", "configurePreset": "linux", "targets": ["kobalt-fast-tests"], "jobs": 2 },
    { "name": "linux-light-tests", "configurePreset": "linux", "targets": ["kobalt-desktop-tests"], "jobs": 2 },
    { "name": "linux-light-screenshots", "configurePreset": "linux", "targets": ["screenshots-light"], "jobs": 2 },
    { "name": "linux-screenshots", "configurePreset": "linux", "targets": ["screenshots"], "jobs": 2 },
    { "name": "linux-perf", "configurePreset": "linux-perf", "targets": ["perf"], "jobs": 2 },
    { "name": "linux-eval", "configurePreset": "linux", "targets": ["kobalt-eval-compare"], "jobs": 2 }
  ],
  "testPresets": [
    {
      "name": "mac",
      "configurePreset": "mac",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 6, "noTestsAction": "error" }
    },
    { "name": "mac-light", "inherits": "mac", "filter": { "include": { "label": "light" } } },
    { "name": "mac-fast", "inherits": "mac", "filter": { "include": { "label": "fast" } } },
    { "name": "mac-integration", "inherits": "mac", "filter": { "include": { "label": "integration" } } },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 2,
        "noTestsAction": "error"
      }
    },
    { "name": "linux-light", "inherits": "linux", "filter": { "include": { "label": "light"}} },
    { "name": "linux-fast", "inherits": "linux", "filter": { "include": { "label": "fast"}} },
    { "name": "linux-integration", "inherits": "linux", "filter": { "include": { "label": "integration"}} }
  ]
}
