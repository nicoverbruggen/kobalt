+    // Source line boxes, relative to page start. These do not change pagination.
+    LVArray<lvPoint> justificationLines;
+    int justificationExtra(int available) const {
+        int count = justificationLines.length();
+        if (count < 6 || footnotes.length() || (flags & RN_PAGE_KEEP_VERTICAL_SPACING)) return 0;
+        int extra = available - justificationLines[count-1].y;
+        int average = (justificationLines[count-1].y - justificationLines[0].x) / count;
+        // Avoid conspicuous leading on sparse pages or after large kept blocks.
+        return extra > 0 && extra <= available / 8 && extra <= (count-1) * average / 8 ? extra : 0;
+    }
+    int centeringOffset(int available) const {
+        if (!justificationLines.length() || footnotes.length() || available <= 0) return 0;
+        int top = justificationLines[0].x;
+        int occupied = justificationLines[justificationLines.length()-1].y - top;
+        if (occupied > available || occupied * 10 < available * 9) return 0;
+        return (available - occupied) / 2 - top;
+    }
+    int justificationOffset(int y, int available, int mode, bool bottom=false) const {
+        if (mode == 2) return centeringOffset(available);
+
+        int extra = justificationExtra(available);
+        if (!extra) return 0;
+        if (bottom) --y;
+        int index = 0;
+        while (index+1 < justificationLines.length() && y >= justificationLines[index+1].x) ++index;
+        return extra * index / (justificationLines.length()-1);
+    }
