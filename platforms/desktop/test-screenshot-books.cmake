# A launcher run owns this root so cancellation can remove only its scratch state.
if(NOT "$ENV{KOBALT_TEST_TMP_ROOT}" STREQUAL "")
    set(TEST_ROOT "$ENV{KOBALT_TEST_TMP_ROOT}/screenshot-books")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
set(references "{}")
foreach(name alice maths moby-dick war-and-peace)
    file(WRITE "${TEST_ROOT}/source/${name}.epub" "Pinned ${name} fixture")
    file(SHA256 "${TEST_ROOT}/source/${name}.epub" hash)
    string(JSON references SET "${references}" "${name}"
        "{\"filename\":\"${name}.epub\",\"sha256\":\"${hash}\",\"download\":\"file://${TEST_ROOT}/source/${name}.epub\"}")
endforeach()
file(WRITE "${TEST_ROOT}/references.json" "${references}")
function(prepare expected pattern)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${TEST_ROOT}/cache"
        "-DREFERENCES=${TEST_ROOT}/references.json" -P "${PREPARE_SCRIPT}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "pass")
        if(NOT result STREQUAL "0")
            file(REMOVE_RECURSE "${TEST_ROOT}")
            message(FATAL_ERROR "Pinned offline book preparation failed: ${output}${error}")
        endif()
    elseif(result STREQUAL "0" OR NOT error MATCHES "${pattern}")
        file(REMOVE_RECURSE "${TEST_ROOT}")
        message(FATAL_ERROR "Book corruption was not rejected: ${result} ${error}")
    endif()
endfunction()
prepare(pass "")
# Cached bytes must be checked even when no download is needed.
file(WRITE "${TEST_ROOT}/cache/alice.epub" "Damaged cache")
prepare(fail "Cached screenshot book differs")
file(READ "${TEST_ROOT}/cache/alice.epub" preserved)
if(NOT preserved STREQUAL "Damaged cache")
    file(REMOVE_RECURSE "${TEST_ROOT}")
    message(FATAL_ERROR "Rejected cache entry was overwritten")
endif()
file(COPY_FILE "${TEST_ROOT}/source/alice.epub" "${TEST_ROOT}/cache/alice.epub")
# An upstream change must not become a new accepted fixture or a partial file.
file(REMOVE "${TEST_ROOT}/cache/maths.epub")
file(WRITE "${TEST_ROOT}/source/maths.epub" "Changed upstream book")
prepare(fail "Downloaded screenshot book differs")
if(EXISTS "${TEST_ROOT}/cache/maths.epub" OR EXISTS "${TEST_ROOT}/cache/maths.epub.part")
    file(REMOVE_RECURSE "${TEST_ROOT}")
    message(FATAL_ERROR "Rejected download left accepted or partial bytes")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
