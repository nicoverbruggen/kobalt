# Helpers for the source checks in this folder. A check finds lines that match
# a regular expression, then compares them with an allowlist that sits next to
# the check. An allowlist entry that no longer matches anything also fails, so
# each list only shrinks or changes on purpose.
include_guard(GLOBAL)

# Reads an allowlist into OUT, one entry per line. `#` starts a comment line.
# A semicolon would split an entry into two CMake list items, so it fails.
function(kobalt_read_allowlist file out)
    file(READ "${file}" text)
    if(text MATCHES ";")
        message(FATAL_ERROR "${file}: entries must not contain a semicolon")
    endif()
    file(STRINGS "${file}" lines)
    set(entries)
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t]*(#|$)")
            continue()
        endif()
        string(STRIP "${line}" line)
        list(APPEND entries "${line}")
    endforeach()
    set(${out} "${entries}" PARENT_SCOPE)
endfunction()

# Lists the C and C++ sources below each of DIRS (relative to ROOT).
function(kobalt_list_sources root dirs out)
    set(globs)
    foreach(dir IN LISTS dirs)
        foreach(extension IN ITEMS c cpp h mm)
            list(APPEND globs "${root}/${dir}/*.${extension}")
        endforeach()
    endforeach()
    file(GLOB_RECURSE sources RELATIVE "${root}" ${globs})
    list(SORT sources)
    set(${out} "${sources}" PARENT_SCOPE)
endfunction()

# Finds the lines in SOURCES that match PATTERN, outside line comments. Each
# hit in OUT is `path|function|line|capture`: the enclosing function, the line
# number and the first group of PATTERN. A function definition starts in the
# first column, as the checked-in .clang-format lays it out.
function(kobalt_scan root sources pattern out)
    set(hits)
    foreach(source IN LISTS sources)
        file(READ "${root}/${source}" text)
        if(NOT text MATCHES "${pattern}")
            continue()
        endif()
        # One list item per line. Backslashes, semicolons and square brackets
        # would escape, split or group CMake list items, so replace them first.
        string(REPLACE "\\" "<backslash>" text "${text}")
        string(REPLACE ";" "<semicolon>" text "${text}")
        string(REPLACE "[" "<bracket>" text "${text}")
        string(REPLACE "]" "<bracket>" text "${text}")
        string(REPLACE "\n" ";" lines "${text}")
        set(function "(file scope)")
        set(number 0)
        foreach(line IN LISTS lines)
            math(EXPR number "${number} + 1")
            if(line MATCHES "^[A-Za-z_~]" AND line MATCHES "\\(" AND NOT line MATCHES "<semicolon>[ \t]*$"
               AND NOT line MATCHES "^(namespace|using|typedef|template|class|struct|enum|extern)[ \t]")
                string(REGEX MATCH "[A-Za-z_~][A-Za-z0-9_:~]*[ \t]*\\(" name "${line}")
                string(REGEX REPLACE "[ \t]*\\($" "" function "${name}")
            endif()
            if(line MATCHES "^[ \t]*(//|\\*|/\\*)" OR NOT line MATCHES "${pattern}")
                continue()
            endif()
            list(APPEND hits "${source}|${function}|${number}|${CMAKE_MATCH_1}")
        endforeach()
    endforeach()
    set(${out} "${hits}" PARENT_SCOPE)
endfunction()

# Compares HITS with an allowlist of `path|function|reason` lines and appends
# each unlisted hit and each stale entry to the list named by PROBLEM_LIST.
function(kobalt_check_sites what hits allow problem_list)
    kobalt_read_allowlist("${allow}" entries)
    set(allowed)
    foreach(entry IN LISTS entries)
        if(NOT entry MATCHES "^([^|]+)\\|([^|]+)\\|(.+)$")
            message(FATAL_ERROR "${allow}: expected `path|function|reason`: ${entry}")
        endif()
        list(APPEND allowed "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
    endforeach()
    set(found)
    set(result ${${problem_list}})
    foreach(hit IN LISTS hits)
        string(REGEX MATCH "^([^|]+)\\|([^|]+)\\|([0-9]+)" ignored "${hit}")
        set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
        if(key IN_LIST allowed)
            list(APPEND found "${key}")
        else()
            list(APPEND result "${what}: ${CMAKE_MATCH_1}:${CMAKE_MATCH_3} in ${CMAKE_MATCH_2}")
        endif()
    endforeach()
    foreach(entry IN LISTS allowed)
        if(NOT entry IN_LIST found)
            list(APPEND result "${what}: allowlist entry without a match, remove it: ${entry}")
        endif()
    endforeach()
    set(${problem_list} "${result}" PARENT_SCOPE)
endfunction()

# Compares the captured names in HITS with an allowlist of names and appends
# each unlisted name and each stale entry to the list named by PROBLEM_LIST.
# With MEANINGS, each line is `name|meaning` and the meaning is required.
function(kobalt_check_names what hits allow problem_list)
    kobalt_read_allowlist("${allow}" entries)
    set(allowed)
    foreach(entry IN LISTS entries)
        if("MEANINGS" IN_LIST ARGN)
            if(NOT entry MATCHES "^([^|]+)\\|(.+)$")
                message(FATAL_ERROR "${allow}: expected `name|meaning`: ${entry}")
            endif()
            list(APPEND allowed "${CMAKE_MATCH_1}")
        else()
            list(APPEND allowed "${entry}")
        endif()
    endforeach()
    set(found)
    set(reported)
    set(result ${${problem_list}})
    foreach(hit IN LISTS hits)
        string(REGEX MATCH "^([^|]+)\\|([^|]+)\\|([0-9]+)\\|(.*)$" ignored "${hit}")
        set(name "${CMAKE_MATCH_4}")
        if(name IN_LIST allowed)
            list(APPEND found "${name}")
        elseif(NOT name IN_LIST reported)
            # Report each name once, at its first use.
            list(APPEND reported "${name}")
            list(APPEND result "${what}: `${name}` at ${CMAKE_MATCH_1}:${CMAKE_MATCH_3}")
        endif()
    endforeach()
    foreach(entry IN LISTS allowed)
        if(NOT entry IN_LIST found)
            list(APPEND result "${what}: allowlist entry without a match, remove it: ${entry}")
        endif()
    endforeach()
    set(${problem_list} "${result}" PARENT_SCOPE)
endfunction()
