+
+bool ldomPrepareSearchBlock(ldomXPointerEx & next, const ldomXPointerEx & end,
+                           lString32 & text, LVArray<ldomSearchOrigin> & origins, lUInt32 flags)
+{
+    text.clear();
+    origins.clear();
+    if (next.isNull() || next.compare(end) >= 0)
+        return false;
+    if (!next.isText() && !next.nextVisibleText())
+        return false;
+    EnhancedSearchBlockBuffer buffer;
+    if (!buildForwardEnhancedSearchBlock(next, end, true, flags, buffer))
+        return false;
+    text = buffer.text;
+    for (int i = 0; i < buffer.origins.length(); ++i)
+        origins.add({buffer.origins[i].node, buffer.origins[i].offset});
+    next = buffer.lastNode;
+    if (!next.nextVisibleText() || next.compare(end) >= 0)
+        next = end;
+    return true;
+}
