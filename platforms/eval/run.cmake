# Records one evaluation run of a subject: tests, screenshots, performance
# scenarios and, with an external runner, device scenarios. See
# doc/release-evaluation.md. Every step uses the subject's own presets.
#
#   cmake [-DSUBJECT=worktree|<revision>] [-DPROFILE=quick|release] [-DPARTS=tests;screenshots;perf;device]
#         [-DRUNS=n] [-DPATCH=<file>] [-DDEVICE_RUNNER=<program>] [-DDEVICE_TARGETS=qt5] [-DKEEP_DEVICE=<name>]
#         [-DRECORD_BASELINE=ON] -P platforms/eval/run.cmake
cmake_minimum_required(VERSION 3.22)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(desktop_platform mac)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(desktop_platform linux)
else()
    message(FATAL_ERROR "Native evaluation supports macOS and Linux")
endif()
set(eval "${root}/build/eval")
if(NOT DEFINED SUBJECT)
    set(SUBJECT worktree)
endif()
if(NOT DEFINED PROFILE)
    set(PROFILE quick)
endif()
if(NOT DEFINED DEVICE_RUNNER AND DEFINED ENV{KOBALT_DEVICE_RUNNER})
    set(DEVICE_RUNNER "$ENV{KOBALT_DEVICE_RUNNER}")
endif()
if(NOT DEFINED DEVICE_TARGETS)
    set(DEVICE_TARGETS qt5)
endif()
# The quick profile keeps an iteration within a few minutes. The release
# profile runs everything the release checks require.
if(PROFILE STREQUAL "quick")
    set(test_preset ${desktop_platform}-light)
    set(test_build ${desktop_platform}-light-tests)
    set(shot_preset ${desktop_platform}-light-screenshots)
    set(shot_folder ${desktop_platform}-light)
    set(default_runs 3)
    set(default_parts tests screenshots perf)
elseif(PROFILE STREQUAL "release")
    set(test_preset ${desktop_platform})
    set(test_build ${desktop_platform}-tests)
    set(shot_preset ${desktop_platform}-screenshots)
    set(shot_folder ${desktop_platform})
    set(default_runs 5)
    set(default_parts tests screenshots perf)
    if(DEVICE_RUNNER)
        list(APPEND default_parts device)
    endif()
else()
    message(FATAL_ERROR "PROFILE must be quick or release")
endif()
if(NOT DEFINED PARTS)
    set(PARTS ${default_parts})
endif()
if(NOT DEFINED RUNS)
    set(RUNS ${default_runs})
endif()
if("device" IN_LIST PARTS AND NOT DEVICE_RUNNER)
    message(FATAL_ERROR "The device part needs DEVICE_RUNNER or KOBALT_DEVICE_RUNNER")
endif()

function(git output)
    execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY "${root}" OUTPUT_VARIABLE value
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
function(step name)
    message(STATUS "Evaluation: ${name}")
    string(TIMESTAMP started "%s" UTC)
    set(step_started ${started} PARENT_SCOPE)
endfunction()
function(finish name)
    string(TIMESTAMP now "%s" UTC)
    math(EXPR seconds "${now} - ${step_started}")
    set(durations "${durations}\"${name}\":${seconds}," PARENT_SCOPE)
endfunction()

# The Qt SDK of the checkout's own desktop build, so every subject uses the same one.
if(NOT DEFINED QT_PREFIX)
    set(cache "${root}/build/desktop-${desktop_platform}/CMakeCache.txt")
    if(NOT EXISTS "${cache}")
        message(FATAL_ERROR "Configure the ${desktop_platform} preset first, or pass QT_PREFIX")
    endif()
    file(STRINGS "${cache}" qt_dir REGEX "^Qt6_DIR:PATH=")
    string(REGEX REPLACE "^Qt6_DIR:PATH=(.*)/lib/cmake/Qt6$" "\\1" QT_PREFIX "${qt_dir}")
    if(QT_PREFIX MATCHES "^Qt6_DIR:PATH=")
        # Distribution SDKs may use lib/<architecture>/cmake/Qt6. CMake also
        # accepts the configuration directory itself as a package prefix.
        string(REGEX REPLACE "^Qt6_DIR:PATH=" "" QT_PREFIX "${qt_dir}")
    endif()
endif()
if(NOT EXISTS "${QT_PREFIX}/lib/cmake/Qt6" AND NOT EXISTS "${QT_PREFIX}/Qt6Config.cmake")
    message(FATAL_ERROR "Configure the ${desktop_platform} preset first, or pass QT_PREFIX")
endif()
# One evaluation at a time in all worktrees. Kobo builds wait while it runs.
include("${CMAKE_CURRENT_LIST_DIR}/../load-lock.cmake")
kobalt_lock_evaluation("${root}")

# Resolve the subject. A worktree subject is measured in place. A revision is
# exported with git archive, so no checkout or branch is created.
set(patch_hash "")
if(SUBJECT STREQUAL "worktree")
    if(PATCH)
        message(FATAL_ERROR "PATCH applies to exported revisions only; the worktree is never changed")
    endif()
    git(sha rev-parse HEAD)
    git(status status --porcelain)
    git(diff diff HEAD --binary)
    git(untracked ls-files -o --exclude-standard)
    git(modified diff --name-only --no-renames HEAD)
    # A hash of every modified or new file lets a comparison of two worktree
    # runs name exactly the files that differ between them.
    set(worktree_files "")
    string(REPLACE "\n" ";" changed_files "${modified}\n${untracked}")
    foreach(file IN LISTS changed_files)
        if(file STREQUAL "")
            continue()
        endif()
        set(contents deleted)
        if(EXISTS "${root}/${file}")
            file(SHA256 "${root}/${file}" contents)
        endif()
        string(APPEND worktree_files "${contents} ${file}\n")
    endforeach()
    set(state "${diff}\n${worktree_files}")
    string(SHA256 diff_hash "${state}")
    string(SUBSTRING "${sha}" 0 12 short)
    set(label "worktree-${short}")
    set(dirty false)
    if(NOT status STREQUAL "")
        set(dirty true)
        string(SUBSTRING "${diff_hash}" 0 8 suffix)
        string(APPEND label "-d${suffix}")
    endif()
    set(source "${root}")
else()
    git(sha rev-parse "${SUBJECT}^{commit}")
    string(SUBSTRING "${sha}" 0 12 label)
    set(dirty false)
    set(diff_hash "")
    if(PATCH)
        get_filename_component(PATCH "${PATCH}" ABSOLUTE BASE_DIR "${root}")
        file(SHA256 "${PATCH}" patch_hash)
        string(SUBSTRING "${patch_hash}" 0 8 suffix)
        string(APPEND label "+p${suffix}")
    endif()
    set(source "${eval}/${label}/src")
    if(NOT EXISTS "${source}/.eval-source.json")
        step("export ${SUBJECT}")
        file(REMOVE_RECURSE "${source}")
        file(MAKE_DIRECTORY "${source}")
        execute_process(COMMAND git archive --format=tar "${sha}" COMMAND tar -x -C "${source}"
            WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
        file(READ "${source}/assets/manifest.json" manifest)
        string(JSON version GET "${manifest}" version)
        file(WRITE "${source}/source-info.json" "{\"commit\":\"${sha}\",\"version\":\"${version}\"}\n")
        if(PATCH)
            execute_process(COMMAND patch -p1 --forward --dry-run -i "${PATCH}" WORKING_DIRECTORY "${source}"
                COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
            execute_process(COMMAND patch -p1 --forward -i "${PATCH}" WORKING_DIRECTORY "${source}"
                COMMAND_ERROR_IS_FATAL ANY)
        endif()
        # Verified dependency archives and screenshot books from this checkout
        # keep the export offline. The export builds its dependencies in its
        # own cache, so a run never depends on the shared cache's state.
        # Revisions from before the shared cache read their archives from each
        # build directory.
        include("${root}/dependencies/cache.cmake")
        kobalt_dependency_cache_root("${root}" "$ENV{KOBALT_DEPENDENCY_CACHE}" shared)
        if(EXISTS "${source}/dependencies/cache.cmake")
            set(destinations dependency-cache)
        else()
            set(destinations desktop-${desktop_platform} desktop-${desktop_platform}-perf)
            foreach(target IN LISTS DEVICE_TARGETS)
                list(APPEND destinations kobo-${target}-eval)
            endforeach()
        endif()
        file(READ "${source}/dependencies/manifest.json" pins)
        string(JSON count LENGTH "${pins}")
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON name MEMBER "${pins}" ${index})
            string(JSON hash GET "${pins}" "${name}" sha256)
            foreach(archive "${shared}/downloads/${name}-${hash}.tar"
                    "${root}/build/desktop-${desktop_platform}/downloads/${name}-${hash}.tar")
                if(EXISTS "${archive}")
                    file(SHA256 "${archive}" actual)
                    if(actual STREQUAL hash)
                        foreach(directory IN LISTS destinations)
                            file(COPY "${archive}" DESTINATION "${source}/build/${directory}/downloads")
                        endforeach()
                        break()
                    endif()
                endif()
            endforeach()
        endforeach()
        # A copy, not a link: the Kobo build container mounts only the export,
        # and evaluation packages include War and Peace from here.
        if(EXISTS "${root}/build/screenshot-books")
            file(GLOB books "${root}/build/screenshot-books/*.epub")
            file(COPY ${books} DESTINATION "${source}/build/screenshot-books")
        endif()
        file(WRITE "${source}/.eval-source.json" "{\"sha\":\"${sha}\",\"patch_sha256\":\"${patch_hash}\"}\n")
        finish(export)
    endif()
endif()

string(TIMESTAMP stamp "%Y%m%dT%H%M%SZ" UTC)
set(run "${eval}/${label}/runs/${stamp}")
set(partial "${run}.partial")
file(REMOVE_RECURSE "${partial}")
file(MAKE_DIRECTORY "${partial}")
if(SUBJECT STREQUAL "worktree")
    file(WRITE "${partial}/worktree-files.txt" "${worktree_files}")
endif()
set(desktop "${source}/platforms/desktop")
file(READ "${desktop}/CMakePresets.json" presets)
set(has_perf OFF)
if(presets MATCHES "\"${desktop_platform}-perf\"")
    set(has_perf ON)
endif()
# An exported revision uses its own dependency cache; see the export above.
set(cache_environment)
if(NOT source STREQUAL root)
    set(cache_environment "KOBALT_DEPENDENCY_CACHE=${source}/build/dependency-cache")
endif()
function(configure preset directory)
    if(NOT EXISTS "${source}/build/${directory}/CMakeCache.txt")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${cache_environment}
            "${CMAKE_COMMAND}" --preset ${preset} "-DCMAKE_PREFIX_PATH=${QT_PREFIX}"
            WORKING_DIRECTORY "${desktop}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

# Host facts that decide whether two runs' timings can be compared. They are
# read before the run, so its own load does not count.
macro(host output)
    execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE ${output} OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endmacro()
if(desktop_platform STREQUAL "mac")
    host(model sysctl -n hw.model)
    host(cpu sysctl -n machdep.cpu.brand_string)
    host(cores sysctl -n hw.ncpu)
    host(os sw_vers -productVersion)
    host(load sysctl -n vm.loadavg)
    host(battery pmset -g batt)
    host(settings pmset -g)
    set(power battery)
    if(battery MATCHES "AC Power")
        set(power ac)
    endif()
    set(low_power false)
    if(settings MATCHES "(lowpowermode|powermode)[ \t]+1")
        set(low_power true)
    endif()
else()
    host(model uname -n)
    host(cpu uname -m)
    host(cores getconf _NPROCESSORS_ONLN)
    host(os uname -sr)
    file(READ "/proc/loadavg" load)
    string(STRIP "${load}" load)
    set(power unknown)
    set(low_power false)
endif()
# Build everything before measuring, so no build competes with a timing.
step(build)
configure(${desktop_platform} desktop-${desktop_platform})
if("tests" IN_LIST PARTS OR "screenshots" IN_LIST PARTS)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset ${test_build} WORKING_DIRECTORY "${desktop}"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
if("perf" IN_LIST PARTS)
    if(has_perf)
        configure(${desktop_platform}-perf desktop-${desktop_platform}-perf)
        execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset ${desktop_platform}-perf --target kobalt-desktop-tests
            WORKING_DIRECTORY "${desktop}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        message(WARNING "The subject has no ${desktop_platform}-perf preset; skipping performance scenarios")
        list(REMOVE_ITEM PARTS perf)
    endif()
endif()
if("device" IN_LIST PARTS)
    foreach(target IN LISTS DEVICE_TARGETS)
        # The export copied the checkout's verified archives, which keeps the
        # evaluation build offline.
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${cache_environment}
            bash platforms/kobo/build.sh ${target}-eval WORKING_DIRECTORY "${source}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endif()
finish(build)
# A Kobo build that started before this evaluation must end before the measured steps.
kobalt_wait_for_builds("${root}")

set(tests_exit "")
if("tests" IN_LIST PARTS)
    step(tests)
    # The release profile repeats the desktop checks at every gallery variant.
    set(test_environment "")
    if(PROFILE STREQUAL "release")
        set(test_environment KOBALT_TEST_ALL_VARIANTS=1)
    endif()
    # The full suite runs through the subject's validation record, so a pass
    # counts for the validation guard. An older subject without it runs CTest.
    set(tests_command ctest --preset ${test_preset} --output-junit "${partial}/tests.xml")
    if(test_preset STREQUAL desktop_platform AND EXISTS "${source}/platforms/validation-record.cmake")
        set(tests_command "${CMAKE_COMMAND}" -DPRESET=${test_preset} "-DJUNIT=${partial}/tests.xml"
            -P "${source}/platforms/validation-record.cmake")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${test_environment} ${tests_command}
        WORKING_DIRECTORY "${desktop}" RESULT_VARIABLE tests_exit OUTPUT_FILE "${partial}/tests.log"
        ERROR_FILE "${partial}/tests.log")
    finish(tests)
endif()
# A failing part is recorded, like failing tests, so the report still shows
# everything that did run.
set(screenshots_exit "")
if("screenshots" IN_LIST PARTS)
    step(screenshots)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset ${shot_preset} WORKING_DIRECTORY "${desktop}"
        RESULT_VARIABLE screenshots_exit OUTPUT_FILE "${partial}/screenshots.log" ERROR_FILE "${partial}/screenshots.log")
    # APFS clones keep this copy cheap; a later in-place run replaces the gallery.
    if(screenshots_exit STREQUAL "0")
        execute_process(COMMAND cp -cR "${source}/build/screenshots/${shot_folder}" "${partial}/screenshots"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
    finish(screenshots)
endif()
set(perf_failures 0)
if("perf" IN_LIST PARTS)
    step("performance, ${RUNS} processes")
    # The preset runs one pinned process and writes perf/perf.json.
    set(output "${source}/build/desktop-${desktop_platform}-perf/perf/perf.json")
    foreach(index RANGE 1 ${RUNS})
        file(REMOVE "${output}")
        execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset ${desktop_platform}-perf WORKING_DIRECTORY "${desktop}"
            RESULT_VARIABLE result OUTPUT_FILE "${partial}/perf-${index}.log" ERROR_FILE "${partial}/perf-${index}.log")
        if(result STREQUAL "0" AND EXISTS "${output}")
            file(RENAME "${output}" "${partial}/perf-${index}.json")
        else()
            math(EXPR perf_failures "${perf_failures} + 1")
        endif()
    endforeach()
    finish(perf)
endif()
if("device" IN_LIST PARTS)
    foreach(target IN LISTS DEVICE_TARGETS)
        step("device ${target}")
        set(keep "")
        if(KEEP_DEVICE)
            set(keep --keep-device "${KEEP_DEVICE}")
        endif()
        # The evaluation package carries its scenarios, books and diagnostics switch.
        execute_process(COMMAND "${DEVICE_RUNNER}" run
            --package "${source}/build/kobo-${target}-eval/Kobalt-${target}-eval.zip" --target ${target}
            --output "${partial}/device-${target}" ${keep} RESULT_VARIABLE result)
        if(NOT result STREQUAL "0")
            list(APPEND device_failures ${target})
        endif()
        finish("device_${target}")
    endforeach()
endif()

# Text that comes from paths or the host is escaped before it enters JSON.
function(json_text output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()
foreach(name PATCH QT_PREFIX model cpu os load)
    json_text(${name}_json "${${name}}")
endforeach()
string(REPLACE ";" "\",\"" parts_json "${PARTS}")
string(REPLACE ";" "\",\"" device_failures_json "${device_failures}")
if(device_failures)
    set(device_failures_json "\"${device_failures_json}\"")
endif()
string(REGEX REPLACE ",$" "" durations "${durations}")
string(TIMESTAMP created "%Y-%m-%dT%H:%M:%SZ" UTC)
file(WRITE "${partial}/meta.json" "{
  \"schema\": 1, \"kind\": \"kobalt-eval-run\", \"created_utc\": \"${created}\",
  \"subject\": {\"kind\": \"${SUBJECT}\", \"label\": \"${label}\", \"sha\": \"${sha}\", \"dirty\": ${dirty},
               \"diff_sha256\": \"${diff_hash}\", \"patch\": ${PATCH_json}, \"patch_sha256\": \"${patch_hash}\"},
  \"profile\": \"${PROFILE}\", \"parts\": [\"${parts_json}\"], \"runs\": ${RUNS},
  \"tests_exit\": \"${tests_exit}\", \"screenshots_exit\": \"${screenshots_exit}\",
  \"perf_failures\": ${perf_failures}, \"device_failures\": [${device_failures_json}], \"qt\": ${QT_PREFIX_json},
  \"host\": {\"hw_model\": ${model_json}, \"cpu\": ${cpu_json}, \"cores\": \"${cores}\", \"os\": ${os_json},
            \"power\": \"${power}\", \"low_power_mode\": ${low_power}, \"load_start\": ${load_json}},
  \"durations_s\": {${durations}}
}
")
file(RENAME "${partial}" "${run}")
file(WRITE "${eval}/latest.json" "{\"label\":\"${label}\",\"run\":\"${run}\"}\n")
if(RECORD_BASELINE)
    file(WRITE "${eval}/baseline.json" "{\"label\":\"${label}\",\"run\":\"${run}\"}\n")
    message(STATUS "Recorded baseline: ${run}")
endif()
message(STATUS "Evaluation run: ${run}")
if(tests_exit AND NOT tests_exit STREQUAL "0")
    message(WARNING "Tests failed in this run; see ${run}/tests.log")
endif()
if(screenshots_exit AND NOT screenshots_exit STREQUAL "0")
    message(WARNING "Screenshots failed in this run; see ${run}/screenshots.log")
endif()
if(perf_failures GREATER 0)
    message(WARNING "${perf_failures} performance processes failed; see the perf logs in ${run}")
endif()
if(device_failures)
    message(WARNING "The device runner failed for: ${device_failures}")
endif()
