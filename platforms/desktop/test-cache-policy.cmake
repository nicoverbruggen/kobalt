# A launcher run owns this root so cancellation can remove only its scratch state.
if(NOT "$ENV{KOBALT_TEST_TMP_ROOT}" STREQUAL "")
    set(TEST_ROOT "$ENV{KOBALT_TEST_TMP_ROOT}/cache-policy")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source/dependencies/patches")
file(READ "${POLICY_FILE}" policy_source)
file(WRITE "${TEST_ROOT}/policy.cmake" "${policy_source}")
set(POLICY_FILE "${TEST_ROOT}/policy.cmake")
file(WRITE "${TEST_ROOT}/source/dependencies/manifest.json" "engine-one")
file(WRITE "${TEST_ROOT}/source/dependencies/CMakeLists.txt" "recipe-one")
file(WRITE "${TEST_ROOT}/source/dependencies/patches/parser.patch" "patch-one")
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
project(CachePolicy NONE)
set(KOBALT_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
include("${POLICY_FILE}")
file(WRITE "${CMAKE_BINARY_DIR}/policy" "${layout_policy}")
file(WRITE "${CMAKE_BINARY_DIR}/rendering" "${rendering_policy}")
]=])
function(configure version output)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/build"
        "-DPOLICY_FILE=${POLICY_FILE}" "-DKOBALT_VERSION=${version}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cache-policy fixture could not configure: ${error}")
    endif()
    file(READ "${TEST_ROOT}/build/policy" policy)
    file(READ "${TEST_ROOT}/build/rendering" rendering)
    if(NOT policy STREQUAL "849b421de582bf6b89f84263eab8e27dabd97cc0a8cfc807504f170a6ac35b2a")
        message(FATAL_ERROR "A compatible update lost the beta 7 parsed-book cache identity")
    endif()
    set(${output} "${rendering}" PARENT_SCOPE)
endfunction()
configure(beta4 initial)
file(WRITE "${TEST_ROOT}/source/ui.cpp" "changed UI")
configure(beta5 updated)
if(NOT initial STREQUAL updated)
    message(FATAL_ERROR "A release or UI change invalidated the book cache")
endif()
foreach(input manifest.json CMakeLists.txt patches/parser.patch)
    file(APPEND "${TEST_ROOT}/source/dependencies/${input}" "compatible update")
    configure(beta5 changed)
    if(NOT updated STREQUAL changed)
        message(FATAL_ERROR "A compatible ${input} update invalidated cached layout")
    endif()
    set(updated "${changed}")
endforeach()
string(REGEX MATCH "set\\(rendering_version ([0-9]+)\\)" version_declaration "${policy_source}")
math(EXPR next_version "${CMAKE_MATCH_1} + 1")
string(REPLACE "${version_declaration}" "set(rendering_version ${next_version})" incompatible "${policy_source}")
file(WRITE "${POLICY_FILE}" "${incompatible}")
configure(beta5 layout_changed)
if(updated STREQUAL layout_changed)
    message(FATAL_ERROR "An explicit rendering-version change retained cached layout")
endif()
file(WRITE "${POLICY_FILE}" "${policy_source}")
file(MAKE_DIRECTORY "${TEST_ROOT}/source/assets/hyph")
file(WRITE "${TEST_ROOT}/source/assets/hyph/Russian.pattern" "patterns-one")
configure(beta5 added)
if(updated STREQUAL added)
    message(FATAL_ERROR "An added dictionary reused cached pagination")
endif()
file(APPEND "${TEST_ROOT}/source/assets/hyph/Russian.pattern" "updated patterns")
configure(beta5 edited)
if(added STREQUAL edited)
    message(FATAL_ERROR "Changed patterns reused cached pagination")
endif()
file(RENAME "${TEST_ROOT}/source/assets/hyph/Russian.pattern" "${TEST_ROOT}/source/assets/hyph/English.pattern")
configure(beta5 renamed)
if(edited STREQUAL renamed)
    message(FATAL_ERROR "A renamed dictionary reused cached pagination")
endif()
file(REMOVE "${TEST_ROOT}/source/assets/hyph/English.pattern")
configure(beta5 removed)
if(NOT updated STREQUAL removed)
    message(FATAL_ERROR "Removing the dictionary did not restore the original cache policy")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
