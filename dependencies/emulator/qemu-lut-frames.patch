--- a/include/hw/display/mt8113_hwtcon_frame.h
+++ b/include/hw/display/mt8113_hwtcon_frame.h
@@ -0,0 +1,92 @@
+/*
+ * HWTCON pipeline snapshots awaiting their waveform LUT commit.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_DISPLAY_MT8113_HWTCON_FRAME_H
+#define HW_DISPLAY_MT8113_HWTCON_FRAME_H
+
+#include <glib.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct MT8113HWTCONFrame {
+    uint8_t *pixels;
+    uint32_t x, y, width, height;
+    uint32_t source_width, source_height, format, flags;
+    unsigned bytes_per_pixel;
+    uint8_t minimum, maximum;
+} MT8113HWTCONFrame;
+
+static inline void mt8113_hwtcon_frame_clear(MT8113HWTCONFrame *frame)
+{
+    g_free(frame->pixels);
+    memset(frame, 0, sizeof(*frame));
+}
+
+static inline bool mt8113_hwtcon_frame_capture(
+    MT8113HWTCONFrame *frame, const uint8_t *pixels,
+    uint32_t source_width, uint32_t source_height, size_t pitch,
+    unsigned bytes_per_pixel, uint32_t format, uint32_t flags,
+    uint32_t x, uint32_t y, uint32_t width, uint32_t height)
+{
+    size_t row_bytes;
+
+    mt8113_hwtcon_frame_clear(frame);
+    if (!pixels || !width || !height || !source_width || !source_height ||
+        source_width > 4096 || source_height > 4096 ||
+        (bytes_per_pixel != 1 && bytes_per_pixel != 4) ||
+        pitch < (size_t)source_width * bytes_per_pixel ||
+        pitch > 64 * 1024 ||
+        (uint64_t)x + width > source_width ||
+        (uint64_t)y + height > source_height) {
+        return false;
+    }
+    row_bytes = (size_t)width * bytes_per_pixel;
+    frame->pixels = g_try_malloc(row_bytes * height);
+    if (!frame->pixels) {
+        return false;
+    }
+    frame->x = x;
+    frame->y = y;
+    frame->width = width;
+    frame->height = height;
+    frame->source_width = source_width;
+    frame->source_height = source_height;
+    frame->bytes_per_pixel = bytes_per_pixel;
+    frame->format = format;
+    frame->flags = flags;
+    frame->minimum = UINT8_MAX;
+    for (uint32_t row = 0; row < height; row++) {
+        const uint8_t *in = pixels + (size_t)(y + row) * pitch +
+                            (size_t)x * bytes_per_pixel;
+        memcpy(frame->pixels + row * row_bytes, in, row_bytes);
+        for (uint32_t column = 0; column < width; column++) {
+            uint8_t value = in[column * bytes_per_pixel];
+            frame->minimum = MIN(frame->minimum, value);
+            frame->maximum = MAX(frame->maximum, value);
+        }
+    }
+    return true;
+}
+
+static inline bool mt8113_hwtcon_frame_publish(
+    MT8113HWTCONFrame *frame, uint8_t *destination, size_t bytes,
+    size_t pitch)
+{
+    size_t row_bytes = (size_t)frame->width * frame->bytes_per_pixel;
+    bool valid = frame->pixels && destination &&
+        pitch >= (size_t)frame->source_width * frame->bytes_per_pixel &&
+        pitch <= 64 * 1024 && bytes >= pitch * frame->source_height;
+
+    if (valid) {
+        for (uint32_t row = 0; row < frame->height; row++) {
+            memcpy(destination + (size_t)(frame->y + row) * pitch +
+                   (size_t)frame->x * frame->bytes_per_pixel,
+                   frame->pixels + row * row_bytes, row_bytes);
+        }
+    }
+    mt8113_hwtcon_frame_clear(frame);
+    return valid;
+}
+#endif
