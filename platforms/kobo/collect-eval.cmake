# Copies the scenario results and the diagnostics log from a Kobo connected
# over USB into a run's device folder, which compare.cmake reads. Then prints
# the outcome of each device check and writes `manual-checks.json`, the USB
# and power-off saves that the event log shows.
#   cmake -DDEVICE=/Volumes/KOBOeReader -DOUTPUT=build/eval/<label>/runs/<time>/device-qt5
#       -P platforms/kobo/collect-eval.cmake
if(NOT DEFINED DEVICE OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "DEVICE and OUTPUT are required")
endif()
set(diagnostics "${DEVICE}/.adds/kobalt/diagnostics")
if(NOT EXISTS "${diagnostics}/scenarios.jsonl")
    message(FATAL_ERROR "The Kobo has no scenario results yet. Open the test book in Kobalt and wait for "
        "the scenario-run-end event.")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
foreach(name scenarios.jsonl events.jsonl events.jsonl.previous)
    if(EXISTS "${diagnostics}/${name}")
        file(COPY "${diagnostics}/${name}" DESTINATION "${OUTPUT}")
    endif()
endforeach()
message(STATUS "Collected the results into ${OUTPUT}")

# One line per check scenario, and the name of each failed check.
file(READ "${OUTPUT}/scenarios.jsonl" text)
string(REPLACE ";" "@semicolon@" text "${text}")
string(REPLACE "\n" ";" lines "${text}")
set(summary "")
set(passed 0)
set(failed 0)
set(skipped 0)
foreach(line IN LISTS lines)
    string(REPLACE "@semicolon@" ";" line "${line}")
    string(JSON kind ERROR_VARIABLE error GET "${line}" kind)
    if(error OR NOT kind STREQUAL "check")
        continue()
    endif()
    string(JSON id GET "${line}" id)
    string(JSON status GET "${line}" status)
    string(JSON reason ERROR_VARIABLE error GET "${line}" reason)
    if(error)
        set(reason "")
    endif()
    string(JSON count ERROR_VARIABLE error LENGTH "${line}" checks)
    if(error)
        set(count 0)
    endif()
    if(status STREQUAL "completed")
        math(EXPR passed "${passed} + 1")
        string(APPEND summary "  pass  ${id} (${count} checks)\n")
    elseif(status STREQUAL "skipped")
        math(EXPR skipped "${skipped} + 1")
        string(APPEND summary "  skip  ${id}: ${reason}\n")
    else()
        math(EXPR failed "${failed} + 1")
        string(APPEND summary "  FAIL  ${id}: ${reason}\n")
    endif()
endforeach()

# The last USB release and power-off save after the run. Kobalt saves for
# them only while a book is open in it. Qt 5.2 writes a space after the colon.
set(log "")
foreach(name events.jsonl.previous events.jsonl)
    if(EXISTS "${OUTPUT}/${name}")
        file(STRINGS "${OUTPUT}/${name}" found REGEX
            "\"event\": ?\"(scenario-run-end|usb-release-start|usb-release-complete|usb-save-deadline|shutdown-save-start|shutdown-save-complete|shutdown-save-deadline)\"")
        list(APPEND log ${found})
    endif()
endforeach()
set(events "")
foreach(line IN LISTS log)
    if(line MATCHES "\"event\": ?\"([a-z-]+)\"")
        list(APPEND events "${CMAKE_MATCH_1}")
    endif()
endforeach()
list(FIND events scenario-run-end start)
set(usb "not checked")
set(power "not checked")
if(start GREATER_EQUAL 0)
    # Only events after the last run count.
    list(LENGTH events total)
    set(index ${total})
    while(index GREATER 0)
        math(EXPR index "${index} - 1")
        list(GET events ${index} event)
        if(event STREQUAL "scenario-run-end")
            break()
        endif()
    endwhile()
    math(EXPR first "${index} + 1")
    set(after "")
    if(first LESS total)
        list(SUBLIST events ${first} -1 after)
    endif()
    foreach(event IN LISTS after)
        if(event STREQUAL "usb-release-start")
            set(usb "failed: the USB release did not finish")
        elseif(event STREQUAL "usb-save-deadline")
            set(usb "failed: the save before USB ran out of time")
        elseif(event STREQUAL "usb-release-complete" AND usb MATCHES "did not finish")
            set(usb "passed")
        elseif(event STREQUAL "shutdown-save-start")
            set(power "failed: the power-off save did not finish")
        elseif(event STREQUAL "shutdown-save-deadline")
            set(power "failed: the power-off save ran out of time")
        elseif(event STREQUAL "shutdown-save-complete" AND power MATCHES "did not finish")
            set(power "passed")
        endif()
    endforeach()
endif()
string(REGEX REPLACE ":.*" "" usb_status "${usb}")
string(REGEX REPLACE ":.*" "" power_status "${power}")
file(WRITE "${OUTPUT}/manual-checks.json"
    "{\"usb_save\": \"${usb_status}\", \"power_off_save\": \"${power_status}\"}\n")
if(passed OR failed OR skipped)
    message(STATUS "Device checks: ${passed} passed, ${failed} failed, ${skipped} skipped\n${summary}"
        "USB connect save: ${usb}\nPower-off save: ${power}")
endif()
