cmake_minimum_required(VERSION 3.22)
if(NOT IS_ABSOLUTE "${APP}" OR NOT IS_ABSOLUTE "${BUILD}")
    message(FATAL_ERROR "APP and BUILD must be absolute")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef identity)
set(scratch "${BUILD}/test-tmp/device-${identity}")
file(MAKE_DIRECTORY "${scratch}")
execute_process(COMMAND "${APP}" "${scratch}" TIMEOUT 12 RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
file(REMOVE_RECURSE "${scratch}")
message("${output}${errors}")
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Kindle device check failed: ${result}")
endif()
