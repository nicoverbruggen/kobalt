# Records validation runs that passed, so that a full run is not repeated on
# an unchanged tree. See doc/validation.md#validation-guard.
#
#   cmake -DPRESET=mac -P platforms/validation-record.cmake
#       Builds mac-tests, runs `ctest --preset mac` and records the run if it
#       passes. It exits with the status of the failed step. -DARGS="-L;model"
#       runs and records that selection instead. -DJUNIT=<file> also writes a
#       JUnit report; it does not change which run is recorded.
#   cmake -DMODE=check -DRUN=ctest:mac -P platforms/validation-record.cmake
#       Reports whether the current tree already passed that run.
#   cmake -DMODE=hash -P platforms/validation-record.cmake
#       Prints the tree hash.
#
# The screenshots target and platforms/kobo/build.sh call MODE=begin before
# their work and MODE=record after it. The launcher and platforms/eval/run.cmake
# run the full suite through PRESET. MODE=hook is the Claude Code PreToolUse
# hook in .claude/settings.json. It reads the hook input from stdin.
#
# Records live in build/validation/ of the worktree that ran. The tree hash
# covers tracked and untracked files that Git does not ignore, except doc/,
# Markdown files, .claude/ and build/.
cmake_minimum_required(VERSION 3.22)

set(kobalt_pathspec . ":(exclude)build" ":(exclude)doc" ":(exclude)*.md" ":(exclude).claude")

# Runs Git in root. Sets out to its output and out_ok to whether it succeeded.
function(kobalt_git out root)
    execute_process(COMMAND git -c core.quotepath=off -C "${root}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_QUIET)
    set(${out} "${output}" PARENT_SCOPE)
    if(result EQUAL 0)
        set(${out}_ok TRUE PARENT_SCOPE)
    else()
        set(${out}_ok FALSE PARENT_SCOPE)
    endif()
endfunction()

# Turns Git output into a list of lines. A semicolon in a path cannot be held
# in a CMake list, so it makes the hash unknown.
function(kobalt_lines out text)
    string(FIND "${text}" ";" semicolon)
    if(NOT semicolon EQUAL -1)
        set(${out}_ok FALSE PARENT_SCOPE)
        return()
    endif()
    string(STRIP "${text}" text)
    string(REPLACE "\n" ";" lines "${text}")
    set(${out} "${lines}" PARENT_SCOPE)
    set(${out}_ok TRUE PARENT_SCOPE)
endfunction()

# Sets out to a hash of every build-relevant file's content and path, or to an
# empty string when Git cannot say. Unchanged files use the blob ID that Git
# already has in its index; changed and untracked files are hashed without
# writing to the object store. The same content gives the same hash whether it
# is committed, staged or only in the working tree.
function(kobalt_tree_hash root out)
    set(${out} "" PARENT_SCOPE)
    kobalt_git(changes "${root}" diff-files --name-status --no-renames -- ${kobalt_pathspec})
    kobalt_git(untracked "${root}" ls-files --others --exclude-standard -- ${kobalt_pathspec})
    if(NOT changes_ok OR NOT untracked_ok)
        return()
    endif()
    kobalt_lines(changes "${changes}")
    kobalt_lines(untracked "${untracked}")
    if(NOT changes_ok OR NOT untracked_ok)
        return()
    endif()
    set(hashed ${untracked})
    set(excluded ${untracked})
    foreach(line IN LISTS changes)
        if(line MATCHES "^([A-Z])[0-9]*\t(.+)$")
            list(APPEND excluded "${CMAKE_MATCH_2}")
            if(NOT CMAKE_MATCH_1 STREQUAL "D")
                list(APPEND hashed "${CMAKE_MATCH_2}")
            endif()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES hashed)
    list(REMOVE_DUPLICATES excluded)
    set(exclusions "")
    foreach(path IN LISTS excluded)
        list(APPEND exclusions ":(exclude,literal)${path}")
    endforeach()
    kobalt_git(index "${root}" ls-files --stage -- ${kobalt_pathspec} ${exclusions})
    if(NOT index_ok)
        return()
    endif()
    string(REGEX REPLACE "(^|\n)[0-7]+ ([0-9a-f]+) [0-9]\t" "\\1\\2 " index "${index}")
    kobalt_lines(entries "${index}")
    if(NOT entries_ok)
        return()
    endif()
    if(hashed)
        kobalt_git(blobs "${root}" hash-object -- ${hashed})
        if(NOT blobs_ok)
            return()
        endif()
        kobalt_lines(blobs "${blobs}")
        list(LENGTH hashed count)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            list(GET blobs ${i} blob)
            list(GET hashed ${i} path)
            list(APPEND entries "${blob} ${path}")
        endforeach()
    endif()
    list(SORT entries)
    list(JOIN entries "\n" manifest)
    string(SHA256 hash "${manifest}")
    set(${out} "${hash}" PARENT_SCOPE)
endfunction()

# A Kobo package also depends on its logging choice and an explicit release
# version. A publication build, which sets that version, also depends on the
# commit it records. A validation build does not: a new commit of the same
# sources is not a reason to rebuild.
function(kobalt_kobo_options root target diagnostics version out)
    if(target MATCHES "-diagnostic$" OR diagnostics STREQUAL "")
        set(diagnostics ON)
    endif()
    set(options "diagnostics=${diagnostics} version=${version}")
    if(NOT version STREQUAL "")
        kobalt_git(commit "${root}" rev-parse HEAD)
        string(STRIP "${commit}" commit)
        string(APPEND options " commit=${commit}")
    endif()
    set(${out} "${options}" PARENT_SCOPE)
endfunction()

# A representative run does not establish coverage of every variant.
function(kobalt_test_options value out)
    if(value STREQUAL "1")
        set(${out} "variants=all" PARENT_SCOPE)
    elseif(value STREQUAL "" OR value STREQUAL "0")
        set(${out} "variants=representative" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "KOBALT_TEST_ALL_VARIANTS must be 0 or 1")
    endif()
endfunction()

# A filtered gallery capture is not the full gallery.
function(kobalt_gallery_filtered out)
    if(NOT "$ENV{KOBALT_GALLERY_SCENE}" STREQUAL "" OR NOT "$ENV{KOBALT_GALLERY_CASE}" STREQUAL "")
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Sets out to the time the run passed with these options on this tree, or to
# an empty string.
function(kobalt_find_record root run options tree out)
    set(${out} "" PARENT_SCOPE)
    set(records "${root}/build/validation/passed.tsv")
    if(tree STREQUAL "" OR NOT EXISTS "${records}")
        return()
    endif()
    file(STRINGS "${records}" lines)
    foreach(line IN LISTS lines)
        string(REPLACE "\t" ";" fields "${line}")
        list(LENGTH fields count)
        if(count EQUAL 4)
            list(GET fields 0 recorded_run)
            list(GET fields 1 recorded_options)
            list(GET fields 2 recorded_tree)
            list(GET fields 3 recorded_time)
            if(recorded_run STREQUAL run AND recorded_options STREQUAL options AND recorded_tree STREQUAL tree)
                set(${out} "${recorded_time}" PARENT_SCOPE)
            endif()
        endif()
    endforeach()
endfunction()

function(kobalt_pending_file root run options out)
    string(MD5 key "${run} ${options}")
    set(${out} "${root}/build/validation/pending-${key}.txt" PARENT_SCOPE)
endfunction()

# Records that the run passed. start is the tree hash from when the run began,
# or empty to use the pending hash that MODE=begin saved. A tree that changed
# during the run is not recorded. Recording never fails the run.
function(kobalt_record root run options start)
    kobalt_pending_file("${root}" "${run}" "${options}" pending)
    if(start STREQUAL "" AND EXISTS "${pending}")
        file(READ "${pending}" start)
        string(STRIP "${start}" start)
    endif()
    file(REMOVE "${pending}")
    kobalt_tree_hash("${root}" tree)
    if(tree STREQUAL "")
        message(STATUS "Validation record: Git cannot hash this tree; ${run} not recorded")
        return()
    endif()
    if(NOT start STREQUAL "" AND NOT start STREQUAL tree)
        message(STATUS "Validation record: files changed during the run; ${run} not recorded")
        return()
    endif()
    set(directory "${root}/build/validation")
    file(MAKE_DIRECTORY "${directory}")
    file(LOCK "${directory}/passed.lock" GUARD FUNCTION TIMEOUT 10 RESULT_VARIABLE locked)
    if(NOT locked EQUAL 0)
        message(STATUS "Validation record: cannot lock ${directory}; ${run} not recorded")
        return()
    endif()
    set(records "${directory}/passed.tsv")
    set(kept "")
    if(EXISTS "${records}")
        file(STRINGS "${records}" lines)
        foreach(line IN LISTS lines)
            if(NOT line MATCHES "^([^\t]*)\t([^\t]*)\t" OR NOT CMAKE_MATCH_1 STREQUAL run OR NOT CMAKE_MATCH_2 STREQUAL options)
                string(APPEND kept "${line}\n")
            endif()
        endforeach()
    endif()
    string(TIMESTAMP now "%Y-%m-%d %H:%M:%S")
    file(WRITE "${records}.tmp" "${kept}${run}\t${options}\t${tree}\t${now}\n")
    file(RENAME "${records}.tmp" "${records}")
    message(STATUS "Validation record: ${run} (${options}) passed on tree ${tree}")
endfunction()

# Hook helpers. Shell parsing here is deliberately simple: anything it cannot
# read with certainty is allowed.
function(kobalt_json_string out text)
    string(REPLACE "\\" "\\\\" text "${text}")
    string(REPLACE "\"" "\\\"" text "${text}")
    string(REPLACE "\n" "\\n" text "${text}")
    string(REPLACE "\t" "\\t" text "${text}")
    set(${out} "\"${text}\"" PARENT_SCOPE)
endfunction()

# Resolves a cd target against the current directory. Sets out to an empty
# string when the directory is not known.
function(kobalt_resolve_directory out current target)
    set(${out} "" PARENT_SCOPE)
    if(target STREQUAL "" OR target STREQUAL "~")
        set(target "$ENV{HOME}")
    elseif(target MATCHES "^~/(.*)$")
        set(target "$ENV{HOME}/${CMAKE_MATCH_1}")
    elseif(target MATCHES "[$`*?]" OR target STREQUAL "-")
        return()
    endif()
    if(NOT IS_ABSOLUTE "${target}")
        if(current STREQUAL "")
            return()
        endif()
        set(target "${current}/${target}")
    endif()
    get_filename_component(target "${target}" REALPATH)
    if(IS_DIRECTORY "${target}")
        set(${out} "${target}" PARENT_SCOPE)
    endif()
endfunction()

# Sets out to the worktree whose platforms/desktop/ is directory, or to an
# empty string. The launcher has presets with the same names; they stay free.
function(kobalt_desktop_root out directory)
    set(${out} "" PARENT_SCOPE)
    if(directory STREQUAL "")
        return()
    endif()
    get_filename_component(root "${directory}/../.." REALPATH)
    if(EXISTS "${root}/platforms/desktop/CMakePresets.json")
        get_filename_component(desktop "${root}/platforms/desktop" REALPATH)
        if(desktop STREQUAL directory)
            set(${out} "${root}" PARENT_SCOPE)
        endif()
    endif()
endfunction()

# Looks up a variable for the command: an assignment earlier in the command,
# then the hook's own environment.
macro(kobalt_hook_variable out name)
    if(DEFINED assigned_${name})
        set(${out} "${assigned_${name}}")
    else()
        set(${out} "$ENV{${name}}")
    endif()
endmacro()

# Adds a guarded run: the worktree, run name, options and the output that must
# still exist for a record to count.
macro(kobalt_guard root run options output)
    list(APPEND guarded_roots "${root}")
    list(APPEND guarded_runs "${run}")
    list(APPEND guarded_options "${options}")
    list(APPEND guarded_outputs "${output}")
endmacro()

# Do not guess the coverage when a shell expression supplies the option.
macro(kobalt_guard_tests root preset)
    kobalt_hook_variable(variants KOBALT_TEST_ALL_VARIANTS)
    if(variants MATCHES "^(0|1)?$")
        kobalt_test_options("${variants}" options)
        kobalt_guard("${root}" "ctest:${preset}" "${options}" "build/desktop-${preset}")
    endif()
endmacro()

# Reads one ctest invocation. Only --preset mac or linux with options that do
# not select tests is a full run.
macro(kobalt_hook_ctest tokens)
    set(preset "")
    set(full TRUE)
    set(skip_next FALSE)
    set(after_preset FALSE)
    foreach(token IN LISTS ${tokens})
        if(after_preset)
            set(preset "${token}")
            set(after_preset FALSE)
        elseif(skip_next)
            set(skip_next FALSE)
        elseif(token STREQUAL "--preset")
            set(after_preset TRUE)
        elseif(token MATCHES "^--preset=(.*)$")
            set(preset "${CMAKE_MATCH_1}")
        elseif(token MATCHES "^(-j|--parallel|--timeout|--repeat)$")
            set(skip_next TRUE)
        elseif(NOT token MATCHES "^(-j[0-9]+|--parallel=[0-9]+|--output-on-failure|-V|-VV|--verbose|--extra-verbose|-Q|--quiet|--progress|--stop-on-failure|--schedule-random|--no-tests=error|--timeout=[0-9]+)$")
            set(full FALSE)
        endif()
    endforeach()
    kobalt_desktop_root(root "${directory}")
    if(full AND preset MATCHES "^(mac|linux)$" AND NOT root STREQUAL "")
        kobalt_guard_tests("${root}" "${preset}")
        list(APPEND plain_full_runs "${preset}")
    endif()
endmacro()

# Reads one cmake invocation: the validation-record wrapper or a build of the
# full gallery.
macro(kobalt_hook_cmake tokens)
    set(script "")
    set(preset "")
    set(targets "")
    set(wrapper_preset "")
    set(selects FALSE)
    set(build FALSE)
    set(next "")
    foreach(token IN LISTS ${tokens})
        if(next STREQUAL "script")
            set(script "${token}")
            set(next "")
        elseif(next STREQUAL "preset")
            set(preset "${token}")
            set(next "")
        elseif(next STREQUAL "target")
            list(APPEND targets "${token}")
            set(next "")
        elseif(token STREQUAL "-P")
            set(next "script")
        elseif(token STREQUAL "--build")
            set(build TRUE)
        elseif(token STREQUAL "--preset")
            set(next "preset")
        elseif(token MATCHES "^--preset=(.*)$")
            set(preset "${CMAKE_MATCH_1}")
        elseif(token STREQUAL "--target" OR token STREQUAL "-t")
            set(next "target")
        elseif(token MATCHES "^--target=(.*)$")
            list(APPEND targets "${CMAKE_MATCH_1}")
        elseif(token MATCHES "^-DPRESET=(.*)$")
            set(wrapper_preset "${CMAKE_MATCH_1}")
        elseif(token MATCHES "^-D(ARGS|MODE)=")
            set(selects TRUE)
        endif()
    endforeach()
    if(script MATCHES "validation-record\\.cmake$" AND wrapper_preset MATCHES "^(mac|linux)$" AND NOT selects)
        kobalt_resolve_directory(script_directory "${directory}" ".")
        if(NOT IS_ABSOLUTE "${script}" AND NOT script_directory STREQUAL "")
            set(script "${script_directory}/${script}")
        endif()
        if(IS_ABSOLUTE "${script}")
            get_filename_component(script "${script}" REALPATH)
            get_filename_component(script_directory "${script}" DIRECTORY)
            kobalt_desktop_root(root "${script_directory}/desktop")
            if(NOT root STREQUAL "")
                kobalt_guard_tests("${root}" "${wrapper_preset}")
            endif()
        endif()
    elseif(build AND preset MATCHES "^(mac|linux)")
        set(platform "${CMAKE_MATCH_1}")
        if(targets)
            list(FIND targets screenshots gallery)
        elseif(preset MATCHES "^(mac|linux)-screenshots$")
            set(gallery 0)
        else()
            set(gallery -1)
        endif()
        kobalt_hook_variable(scene KOBALT_GALLERY_SCENE)
        kobalt_hook_variable(case KOBALT_GALLERY_CASE)
        kobalt_desktop_root(root "${directory}")
        if(NOT gallery EQUAL -1 AND scene STREQUAL "" AND case STREQUAL "" AND NOT root STREQUAL "")
            kobalt_guard("${root}" "gallery:${platform}" "-" "build/screenshots/${platform}/manifest.json")
        endif()
    endif()
endmacro()

# Reads one Kobo build.sh invocation. --check builds no package.
macro(kobalt_hook_kobo path arguments)
    set(kobo_script "${path}")
    list(LENGTH ${arguments} count)
    if(count EQUAL 1)
        list(GET ${arguments} 0 target)
        kobalt_resolve_directory(script_directory "${directory}" ".")
        if(NOT IS_ABSOLUTE "${kobo_script}" AND NOT script_directory STREQUAL "")
            set(kobo_script "${script_directory}/${kobo_script}")
        endif()
        kobalt_hook_variable(diagnostics KOBALT_VERBOSE_DIAGNOSTICS)
        kobalt_hook_variable(version KOBALT_RELEASE_VERSION)
        if(target MATCHES "^qt[56](-eval|-diagnostic)?$" AND IS_ABSOLUTE "${kobo_script}"
                AND NOT "${diagnostics}${version}" MATCHES "[$`]")
            get_filename_component(kobo_directory "${kobo_script}" DIRECTORY)
            get_filename_component(root "${kobo_directory}/../.." REALPATH)
            if(EXISTS "${root}/platforms/kobo/build.sh")
                kobalt_kobo_options("${root}" "${target}" "${diagnostics}" "${version}" options)
                kobalt_guard("${root}" "kobo:${target}" "${options}" "build/kobo-${target}")
            endif()
        endif()
    endif()
endmacro()

function(kobalt_hook)
    execute_process(COMMAND cat OUTPUT_VARIABLE input RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        return()
    endif()
    string(JSON command ERROR_VARIABLE error GET "${input}" tool_input command)
    if(error OR NOT command MATCHES "ctest|screenshots|kobo/build\\.sh|validation-record")
        return()
    endif()
    if(command MATCHES "(^|[^A-Za-z0-9_])KOBALT_REVALIDATE=1" OR "$ENV{KOBALT_REVALIDATE}" STREQUAL "1")
        return()
    endif()
    string(JSON directory ERROR_VARIABLE error GET "${input}" cwd)
    if(error)
        set(directory "")
    endif()

    # A here-document body is data, not commands.
    string(FIND "${command}" "<<" heredoc)
    if(NOT heredoc EQUAL -1)
        string(SUBSTRING "${command}" ${heredoc} -1 tail)
        string(FIND "${tail}" "\n" newline)
        if(NOT newline EQUAL -1)
            math(EXPR length "${heredoc} + ${newline}")
            string(SUBSTRING "${command}" 0 ${length} command)
        endif()
    endif()
    string(REPLACE ";" "\n" text "${command}")
    # Redirections are not arguments.
    string(REGEX REPLACE "[0-9]*>&[0-9-]+" " " text "${text}")
    string(REGEX REPLACE "&>>?[ \t]*[^ \t\n&|]+" " " text "${text}")
    string(REGEX REPLACE "[0-9]*>>?[ \t]*[^ \t\n&|]+" " " text "${text}")
    string(REGEX REPLACE "<[ \t]*[^ \t\n&|]+" " " text "${text}")
    string(REGEX REPLACE "&&|\\|\\||[|&()\n]" ";" segments "${text}")

    set(guarded_roots "")
    set(guarded_runs "")
    set(guarded_options "")
    set(guarded_outputs "")
    set(plain_full_runs "")
    foreach(segment IN LISTS segments)
        string(STRIP "${segment}" segment)
        separate_arguments(tokens UNIX_COMMAND "${segment}")
        # Leading assignments and transparent wrappers.
        while(tokens)
            list(GET tokens 0 token)
            if(token MATCHES "^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
                set(assigned_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
            elseif(NOT token MATCHES "^(env|export|time|/usr/bin/time|-p|command|exec|nice)$")
                break()
            endif()
            list(REMOVE_AT tokens 0)
        endwhile()
        if(NOT tokens)
            continue()
        endif()
        list(GET tokens 0 program)
        list(REMOVE_AT tokens 0)
        if(program MATCHES "^(cd|pushd)$")
            set(target "")
            if(tokens)
                list(GET tokens 0 target)
            endif()
            kobalt_resolve_directory(directory "${directory}" "${target}")
        elseif(program MATCHES "(^|/)ctest$")
            kobalt_hook_ctest(tokens)
        elseif(program MATCHES "(^|/)cmake$")
            kobalt_hook_cmake(tokens)
        elseif(program MATCHES "(^|/)kobo/build\\.sh$")
            kobalt_hook_kobo("${program}" tokens)
        elseif(program MATCHES "^(bash|sh)$" AND tokens)
            list(GET tokens 0 script)
            if(script MATCHES "(^|/)kobo/build\\.sh$")
                list(REMOVE_AT tokens 0)
                kobalt_hook_kobo("${script}" tokens)
            endif()
        endif()
    endforeach()
    if(NOT guarded_runs)
        return()
    endif()

    set(refused "")
    list(LENGTH guarded_runs count)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        list(GET guarded_roots ${i} root)
        list(GET guarded_runs ${i} run)
        list(GET guarded_options ${i} options)
        list(GET guarded_outputs ${i} output)
        if(NOT EXISTS "${root}/${output}")
            continue()
        endif()
        string(MD5 root_key "${root}")
        if(NOT DEFINED tree_${root_key})
            kobalt_tree_hash("${root}" tree_${root_key})
        endif()
        kobalt_find_record("${root}" "${run}" "${options}" "${tree_${root_key}}" time)
        if(time STREQUAL "")
            continue()
        endif()
        if(run MATCHES "^ctest:(.*)$")
            string(APPEND refused "`ctest --preset ${CMAKE_MATCH_1}` (${options}) already passed on this tree at ${time}. Run only the checks for what changed, such as `ctest --preset ${CMAKE_MATCH_1} -L model`, `-L lifecycle`, `-L kosync` or `-R <test name>`.\n")
        elseif(run MATCHES "^gallery:(.*)$")
            string(APPEND refused "The full gallery in `build/screenshots/${CMAKE_MATCH_1}/` was captured from this tree at ${time}. Recapture only the affected cards with `KOBALT_GALLERY_SCENE=<cards>`.\n")
        elseif(run MATCHES "^kobo:(.*)$")
            string(APPEND refused "The package in `build/kobo-${CMAKE_MATCH_1}/` was built from these sources with the same options at ${time}. Use it as it is. A new commit of the same sources does not need a new package.\n")
        endif()
    endforeach()

    if(NOT refused STREQUAL "")
        kobalt_json_string(reason "Validation guard: no build-relevant file changed since the last pass.\n${refused}Documentation and Markdown edits do not count as changes. If a rerun is necessary, for example to retry a failure outside the tree, put `KOBALT_REVALIDATE=1` before the command and tell the user why.")
        file(WRITE /dev/stdout "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":${reason}}}\n")
    elseif(plain_full_runs)
        list(GET plain_full_runs 0 preset)
        kobalt_json_string(context "Validation guard: a plain `ctest --preset ${preset}` run is not recorded. To record a pass, run `cmake -DPRESET=${preset} -P platforms/validation-record.cmake` from the repository root instead.")
        file(WRITE /dev/stdout "{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":${context}}}\n")
    endif()
endfunction()

# Ends the script with an exit status. CMake before 3.29 can only exit with 1.
macro(kobalt_exit status text)
    message("${text}")
    if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.29)
        cmake_language(EXIT ${status})
    endif()
    message(FATAL_ERROR "${text}")
endmacro()

get_filename_component(kobalt_root "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
set(kobalt_desktop "${kobalt_root}/platforms/desktop")
if(NOT DEFINED MODE AND DEFINED PRESET)
    set(MODE ctest)
endif()
if(NOT DEFINED OPTIONS)
    set(OPTIONS "-")
endif()
if(DEFINED RUN AND RUN MATCHES "^ctest:")
    kobalt_test_options("$ENV{KOBALT_TEST_ALL_VARIANTS}" OPTIONS)
elseif(DEFINED RUN AND RUN MATCHES "^kobo:(.*)$")
    if(NOT DEFINED DIAGNOSTICS)
        set(DIAGNOSTICS ON)
    endif()
    if(NOT DEFINED VERSION)
        set(VERSION "")
    endif()
    kobalt_kobo_options("${kobalt_root}" "${CMAKE_MATCH_1}" "${DIAGNOSTICS}" "${VERSION}" OPTIONS)
endif()

if(MODE STREQUAL "hook")
    kobalt_hook()
elseif(MODE STREQUAL "hash")
    kobalt_tree_hash("${kobalt_root}" tree)
    if(tree STREQUAL "")
        message(FATAL_ERROR "Git cannot hash ${kobalt_root}")
    endif()
    message("${tree}")
elseif(MODE STREQUAL "check")
    if(NOT DEFINED RUN)
        message(FATAL_ERROR "Set RUN, for example -DRUN=ctest:mac")
    endif()
    kobalt_tree_hash("${kobalt_root}" tree)
    kobalt_find_record("${kobalt_root}" "${RUN}" "${OPTIONS}" "${tree}" time)
    if(time STREQUAL "")
        kobalt_exit(1 "${RUN} (${OPTIONS}): not passed on this tree")
    endif()
    message("${RUN} (${OPTIONS}): passed on this tree at ${time}")
elseif(MODE STREQUAL "begin" OR MODE STREQUAL "record")
    if(NOT DEFINED RUN)
        message(FATAL_ERROR "Set RUN")
    endif()
    if(RUN MATCHES "^gallery:")
        kobalt_gallery_filtered(filtered)
        if(filtered)
            return()
        endif()
    endif()
    if(MODE STREQUAL "begin")
        kobalt_tree_hash("${kobalt_root}" tree)
        kobalt_pending_file("${kobalt_root}" "${RUN}" "${OPTIONS}" pending)
        file(WRITE "${pending}" "${tree}\n")
    else()
        kobalt_record("${kobalt_root}" "${RUN}" "${OPTIONS}" "")
    endif()
elseif(MODE STREQUAL "ctest")
    if(NOT PRESET MATCHES "^(mac|linux)$")
        message(FATAL_ERROR "PRESET must be mac or linux")
    endif()
    set(run "ctest:${PRESET}")
    kobalt_test_options("$ENV{KOBALT_TEST_ALL_VARIANTS}" options)
    if(DEFINED ARGS AND NOT ARGS STREQUAL "")
        list(JOIN ARGS " " arguments)
        string(APPEND run " ${arguments}")
    endif()
    set(report "")
    if(DEFINED JUNIT AND NOT JUNIT STREQUAL "")
        set(report --output-junit "${JUNIT}")
    endif()
    get_filename_component(cmake_directory "${CMAKE_COMMAND}" DIRECTORY)
    kobalt_tree_hash("${kobalt_root}" start)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build --preset "${PRESET}-tests"
        WORKING_DIRECTORY "${kobalt_desktop}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        kobalt_exit(${result} "Building ${PRESET}-tests failed; ${run} not recorded")
    endif()
    execute_process(COMMAND "${cmake_directory}/ctest" --preset "${PRESET}" ${ARGS} ${report}
        WORKING_DIRECTORY "${kobalt_desktop}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        kobalt_exit(${result} "${run} failed; not recorded")
    endif()
    if(start STREQUAL "")
        message(STATUS "Validation record: Git cannot hash this tree; ${run} not recorded")
    else()
        kobalt_record("${kobalt_root}" "${run}" "${options}" "${start}")
    endif()
else()
    message(FATAL_ERROR "Set MODE to check, hash, begin, record or hook, or set PRESET")
endif()
