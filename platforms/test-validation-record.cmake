# Checks coverage records and the command guard using a disposable test project.
cmake_minimum_required(VERSION 3.22)
if(NOT TEST_TMP_ROOT)
    message(FATAL_ERROR "Set TEST_TMP_ROOT")
endif()
string(RANDOM LENGTH 12 token)
set(root "${TEST_TMP_ROOT}/validation-record-${token}")
file(MAKE_DIRECTORY "${root}/platforms/desktop" "${root}/build/desktop-mac")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/validation-record.cmake" DESTINATION "${root}/platforms")
set(script "${root}/platforms/validation-record.cmake")
file(WRITE "${root}/.gitignore" "build/\n")
file(WRITE "${root}/platforms/desktop/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.22)
project(record_test NONE)
enable_testing()
add_custom_target(kobalt-tests)
add_test(NAME fixture COMMAND "${CMAKE_COMMAND}" -E true)
]=])
file(WRITE "${root}/platforms/desktop/CMakePresets.json" [=[
{"version":3,"configurePresets":[{"name":"mac","generator":"Unix Makefiles","binaryDir":"${sourceDir}/../../build/desktop-mac"}],"buildPresets":[{"name":"mac-tests","configurePreset":"mac","targets":["kobalt-tests"]}],"testPresets":[{"name":"mac","configurePreset":"mac","execution":{"noTestsAction":"error"}}]}
]=])
foreach(args IN ITEMS "init;-q" "add;." "-c;user.name=Test;-c;user.email=test@example.invalid;-c;commit.gpgsign=false;commit;-qm;Fixture")
    execute_process(COMMAND git ${args} WORKING_DIRECTORY "${root}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --preset mac WORKING_DIRECTORY "${root}/platforms/desktop"
    OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)

function(run mode variants expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KOBALT_TEST_ALL_VARIANTS=${variants}"
        "${CMAKE_COMMAND}" ${ARGN} -DMODE=${mode} -P "${script}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if((expected STREQUAL "pass" AND NOT result EQUAL 0) OR (expected STREQUAL "fail" AND result EQUAL 0))
        message(FATAL_ERROR "${mode} variants=${variants}: unexpected status ${result}\n${output}\n${error}")
    endif()
endfunction()

function(guard variants command denied)
    file(WRITE "${root}/build/hook.json" "{\"cwd\":\"${root}\",\"tool_input\":{\"command\":\"${command}\"}}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=KOBALT_REVALIDATE "KOBALT_TEST_ALL_VARIANTS=${variants}"
        "${CMAKE_COMMAND}" -DMODE=hook -P "${script}" INPUT_FILE "${root}/build/hook.json"
        OUTPUT_VARIABLE output COMMAND_ERROR_IS_FATAL ANY)
    if(denied AND NOT output MATCHES "permissionDecision.*deny")
        message(FATAL_ERROR "Guard did not reject repeated coverage: ${output}")
    elseif(NOT denied AND output MATCHES "permissionDecision.*deny")
        message(FATAL_ERROR "Guard rejected different coverage: ${output}")
    endif()
endfunction()

run(ctest 0 pass -DPRESET=mac)
run(check 0 pass -DRUN=ctest:mac)
run(check 1 fail -DRUN=ctest:mac)
guard(0 "cmake -DPRESET=mac -P platforms/validation-record.cmake" TRUE)
guard(1 "cmake -DPRESET=mac -P platforms/validation-record.cmake" FALSE)
guard(0 "KOBALT_TEST_ALL_VARIANTS=1 cmake -DPRESET=mac -P platforms/validation-record.cmake" FALSE)
guard(0 "cd platforms/desktop && KOBALT_TEST_ALL_VARIANTS=1 ctest --preset mac" FALSE)
run(ctest 1 pass -DPRESET=mac)
run(check 0 pass -DRUN=ctest:mac)
run(check 1 pass -DRUN=ctest:mac)
guard(0 "KOBALT_TEST_ALL_VARIANTS=1 cmake -DPRESET=mac -P platforms/validation-record.cmake" TRUE)
guard(0 "cd platforms/desktop && KOBALT_TEST_ALL_VARIANTS=1 ctest --preset mac" TRUE)
run(ctest 0 pass -DPRESET=mac)
run(check 1 pass -DRUN=ctest:mac)
file(STRINGS "${root}/build/validation/passed.tsv" records)
list(LENGTH records count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Coverage records were lost or duplicated: ${records}")
endif()
# Old records cannot prove either coverage mode.
file(READ "${root}/build/validation/passed.tsv" records)
string(REGEX REPLACE "variants=[a-z]+" "-" records "${records}")
file(WRITE "${root}/build/validation/passed.tsv" "${records}")
run(check 0 fail -DRUN=ctest:mac)
run(check 1 fail -DRUN=ctest:mac)
# A failed suite must not publish a pass for the changed tree.
file(APPEND "${root}/platforms/desktop/CMakeLists.txt" "\nadd_test(NAME failure COMMAND \"${CMAKE_COMMAND}\" -E false)\n")
run(ctest 1 fail -DPRESET=mac)
run(check 1 fail -DRUN=ctest:mac)
run(ctest invalid fail -DPRESET=mac)
file(REMOVE_RECURSE "${root}")
message(STATUS "Validation coverage records and guard passed")
